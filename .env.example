# =============================================================================
# EZBETS configuration
#
# Copy to .env.local and fill in what you need. Everything is optional: with an
# empty file the app runs in demo mode with email sign-in only.
#
# Nothing in this file is a private key or a seed phrase, and nothing in the
# application ever asks for one. Custody keys belong in your provider's key
# management system, never in this file and never in the database.
# =============================================================================

# --- Telegram bot and login --------------------------------------------------
# 1. Open Telegram, message @BotFather and send /newbot.
# 2. Copy the token it gives you into TELEGRAM_BOT_TOKEN below.
# 3. Send /setdomain to @BotFather and give it the host you serve EZBETS from —
#    the Login Widget refuses to render on any other domain.
# 4. Invent your own long random string for TELEGRAM_WEBHOOK_SECRET (for example
#    `openssl rand -hex 32`). Telegram echoes it back in the
#    x-telegram-bot-api-secret-token header and the webhook rejects anything else.
# 5. Publish the bot's profile:  npm run telegram:setup
# 6. Locally, run the bot with:  npm run telegram:bot        (long-polling)
#    In production, register the webhook instead:
#      npm run telegram:setup -- --webhook
#    or Command Center → Platform → Telegram bot → Register webhook.
#    Telegram only calls HTTPS endpoints, so this needs a public EZBETS_PUBLIC_URL.
#
# The token is used server-side only: to verify the Login Widget's HMAC and to
# call the Bot API. It is never sent to the browser.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public origin, used to build the links the bot sends (login, deposit, support).
# Must be the externally reachable URL, not localhost, once you deploy.
#
# The Telegram Login Widget also needs this to be a public HTTPS origin AND to
# match the domain you set with @BotFather → /setdomain. BotFather rejects
# localhost, so on a dev machine the login page automatically offers bot
# sign-in (/login) instead of the widget.
EZBETS_PUBLIC_URL=http://localhost:3000

# Every bot message is headed by public/brand/telegram-banner.png. Set to "off"
# for plain text messages. Regenerate the image with `npm run brand:assets`.
TELEGRAM_MESSAGE_BANNER=on

# --- Google OAuth 2.0 --------------------------------------------------------
# Authorised redirect URI: https://<your-host>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Wallet environment ------------------------------------------------------
# demo       Play money only. No crypto wallets, no addresses, no withdrawals.
# testnet    Crypto wallets backed by the sandbox provider. Testnet-shaped
#            addresses, no keys, no real funds. Deposits arrive only through the
#            operator simulation in Command Center → Finance.
# production Requires a real custody provider (see EZBETS_WALLET_PROVIDER). The
#            sandbox provider refuses to start in production on purpose.
#
# The three environments keep completely separate ledgers. A balance in one is
# never visible in, or transferable to, another.
EZBETS_WALLET_ENV=demo

# The payment/custody provider backing crypto wallets. Only "sandbox" ships with
# this repository. To go live, implement the PaymentProvider interface in
# src/lib/wallet/providers.ts against a regulated custody or payment provider and
# register it there — the app will not silently fall back to a fake.
EZBETS_WALLET_PROVIDER=sandbox

# Salt for the sandbox provider's deterministic address derivation. Changing it
# changes every sandbox deposit address. Meaningless outside testnet.
EZBETS_SANDBOX_SALT=

# Platform withdrawal fee in basis points (100 = 1.00%). Capped at 1000 (10%).
# Shown to the player in the withdrawal quote before they confirm.
EZBETS_WITHDRAWAL_FEE_BPS=0

# --- Treasury ----------------------------------------------------------------
# Watch-only receiving addresses for operator reporting. These are read from the
# environment and never written to the database. Do not put a private key or a
# seed phrase here — the application only ever needs the public address.
EZBETS_TREASURY_BTC=
EZBETS_TREASURY_ETH=
EZBETS_TREASURY_SOL=
EZBETS_TREASURY_USDT_ERC20=

# --- Seed accounts (first boot only) ----------------------------------------
EZBETS_ADMIN_PASSWORD=
EZBETS_DEMO_PASSWORD=

# --- Storage -----------------------------------------------------------------
# Defaults to ./data/ezbets.db
# EZBETS_DATA_DIR=
# EZBETS_DB_FILE=
