# ImmoKnauer — copy to .env.local. All optional; missing providers show "not available", never invented data.

# Bundesbank MFI interest-rate series for housing loans, JSON map bucket -> "<flow>/<series key>".
# Look up current keys at https://www.bundesbank.de/en/statistics/time-series-databases
BUNDESBANK_MORTGAGE_SERIES=

# Protects POST /api/import (CSV listing import). Import is disabled when unset.
IMPORT_TOKEN=

# Enables the AI property assistant (Claude). Without it the assistant returns the structured fact brief.
ANTHROPIC_API_KEY=

# Where the dev listing store lives (default ./data).
DATA_DIR=

# Map tiles (default: OpenStreetMap, attribution required; use a commercial tile provider at scale).
NEXT_PUBLIC_MAP_TILE_URL=
